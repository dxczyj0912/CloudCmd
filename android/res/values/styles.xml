<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      只用平台自带主题，不引 AppCompat —— 这样构建 APK 不需要任何 AndroidX 依赖，
      也就不需要 Gradle 去 Maven 拉包。整个项目仍然是"一个脚本就能构建"。
      窗口背景与站点同色，冷启动时不会先闪一下白屏。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
    </style>
</resources>
