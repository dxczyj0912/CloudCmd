<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      深色模式：站点的主题是"跟随系统"（store.js 的 theme: 'auto'），
      窗口背景也要跟着走，否则深色下冷启动会白闪一下。
      -night 资源限定符从 API 8 起就有，minSdk 24 完全够用。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>
</resources>
