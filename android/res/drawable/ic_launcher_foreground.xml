<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景：一朵白云（站点的品牌符号是 ☁️）。
  用 Material 的 cloud 路径（24x24 viewBox）按 2.67 倍缩放放进 108x108 的自适应图标画布，
  并居中到安全区（自适应图标可能被裁成圆形/方形，外圈 18dp 会被切掉）。
  API 26 以下没有自适应图标，由 tools/android/icons.js 生成 PNG 兜底。
  注：XML 注释里不能出现连续两个减号，所以下面不用分隔线。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="22"
        android:translateY="23"
        android:scaleX="2.67"
        android:scaleY="2.67">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96z" />
    </group>
    <!-- 云里嵌一个终端提示符 ">"，点出"这是一本命令手册"。
         坐标必须让整条线**落在云内部**（云在 108 画布上大致是 x 34..74、y 51..72）：
         云外的部分在蓝底上等于不存在，会看着像云缺了一块。
         线宽 4、圆角端点，和 tools/android/icons.js 里画 PNG 用的是同一组坐标。 -->
    <path
        android:strokeColor="#2F6BFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M50.3,57.7 L56.7,64.1 L50.3,70.5" />
</vector>
